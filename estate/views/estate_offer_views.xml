<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
    
        <record id="estate_offer_list_view" model="ir.ui.view">
            <field name="name">estate.offer.view.list</field>
            <field name="model">estate.offer</field>
            <field name="arch" type="xml">
                <list editable="bottom" decoration-success="state=='accepted'" decoration-danger="state=='refused'">
                    <field name="partner"/>
                    <button name='action_accept_offer' string="Confirm" type="object" icon="fa-check" invisible="state"/>
                    <button name='action_refuse_offer' string="Refuse" type="object" icon="fa-times" invisible="state"/>
                    <!-- <field name='state' width="240px"/> -->
                    <field name='price' width="120px"/>
                    <field name='validity' width="80px"/>
                    <field name='date_availability' width="120px"/>
                </list>
            </field>
        </record>
        
    
    </data>
    

</odoo>
